# Logs
*.log
CLAUDE.local*

# Scratch space: plans, notes, screenshots, local secrets/setup state. Files
# already tracked under tmp/ stay tracked; nothing new is picked up.
tmp/

# Swift Package build artifacts and resolved deps
.build/
client/Package.resolved

# Claude Code internal state — narrow ignores so .claude/commands/*.md
# (slash command spec, expected to be checked-in by OVERVIEW.md + CLAUDE.md)
# remain tracked.
.claude/scheduled_tasks.lock
.claude/settings.local.json
.claude/cache/
.claude/sessions/
MISSION.*.md
MISSION.*.log
MISSION.*.banner
.mission-backups/

