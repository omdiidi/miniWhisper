{% extends "base.html.j2" %}
{% block title %}Sign in · WisprAlt{% endblock %}
{% block bare_content %}
  <main class="login">
    <div class="card">
      <h1>Sign in</h1>
      <p class="muted">Paste your WisprAlt key to see your history and insights.</p>
      {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
      <form method="post" action="/me/login{% if next %}?next={{ next | urlencode }}{% endif %}">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label for="token">Key</label>
        <input type="password" id="token" name="token" autocomplete="off" autofocus required>
        <button type="submit" class="primary">Sign in</button>
      </form>
      <p class="muted small">Admin? <a href="/admin/login">Sign in here</a>.</p>
    </div>
  </main>
{% endblock %}
