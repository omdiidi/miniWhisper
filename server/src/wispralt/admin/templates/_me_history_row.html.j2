{# Compact row: kind, row_id, created_at_iso, word_count, and either a search
   `snippet` (raw, rendered through |highlight) or a `preview`. #}
<tr id="row-{{ row.kind }}-{{ row.row_id }}">
  <td><span class="badge">{{ "Dictation" if row.kind == "dictation" else "File" }}</span></td>
  <td>{{ row.created_at_iso }}</td>
  <td class="num">{{ row.word_count or 0 }}</td>
  <td class="snippet">
    {% if row.snippet is defined %}{{ row.snippet | highlight }}
    {% else %}{{ row.preview if row.preview is defined else (row.text or row.transcript_text or '')[:200] }}{% endif %}
    {% if row.source == 'cloud_fallback' %}<span class="muted small">· cloud sync</span>{% endif %}
  </td>
  <td>
    <button hx-get="/me/history/{{ row.kind }}/{{ row.row_id }}"
            hx-target="#row-{{ row.kind }}-{{ row.row_id }}" hx-swap="outerHTML">Expand</button>
  </td>
</tr>
