{% from "_insight_cards.html.j2" import card_action_items, card_project_pie, card_decisions, card_blockers, card_weekly_digest, card_quotable_line, card_team_themes, card_knowledge_gaps, card_tool_mentions %}
{# HTMX swap target for /admin/data: measured stats, then the AI panel, then (team view)
   the per-person table. #}
{% include "_measured.html.j2" %}

{% if user_id and person_insight %}
  <p class="muted small">AI-generated insights — may be inaccurate.</p>
  {{ card_weekly_digest(person_insight.get('digest', [])) }}
  {{ card_action_items(person_insight.get('action_items', [])) }}
  {{ card_decisions(person_insight.get('decisions', [])) }}
  {{ card_blockers(person_insight.get('blockers', [])) }}
  {{ card_quotable_line(person_insight.get('quotable_line', '')) }}
{% elif not user_id and team_insight %}
  <p class="muted small">AI-generated team insights — may be inaccurate.</p>
  {{ card_team_themes(team_insight.get('themes', [])) }}
  {{ card_knowledge_gaps(team_insight.get('knowledge_gaps', [])) }}
{% endif %}

{% if user_id %}
  <p><a href="/admin/data?range={{ range }}">Back to team</a></p>
{% else %}
  <h2>People ({{ range }})</h2>
  <div class="table-wrap">
    <table>
      <thead>
        <tr><th>Person</th><th class="num">Dictations</th><th class="num">Files</th><th class="num">Words</th><th class="num">Filler words</th><th class="num">Time saved (hrs, est.)</th><th><span class="sr-only">Open</span></th></tr>
      </thead>
      <tbody>
        {% for r in leaderboard %}
          <tr>
            <td>{{ r.name }}</td>
            <td class="num">{{ r.dictations }}</td>
            <td class="num">{{ r.files }}</td>
            <td class="num">{{ "{:,}".format(r.words) }}</td>
            <td class="num">{{ r.fillers }}</td>
            <td class="num">{{ r.time_saved_hours }}</td>
            <td><a href="/admin/data?range={{ range }}&user_id={{ r.id }}">Open</a></td>
          </tr>
        {% else %}
          <tr><td colspan="7"><p class="empty">No people yet.</p></td></tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endif %}
