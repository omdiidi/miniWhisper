{# Expanded row: full text, download, delete. Collapse re-fetches ?compact=1. #}
<tr id="row-{{ row.kind }}-{{ row.row_id }}">
  <td><span class="badge">{{ "Dictation" if row.kind == "dictation" else "File" }}</span></td>
  <td>{{ row.created_at_iso }}</td>
  <td class="num">{{ row.word_count or 0 }}</td>
  <td colspan="2">
    <pre class="transcript">{{ row.text or row.transcript_text or '' }}</pre>
    <div class="row">
      <button hx-get="/me/history/{{ row.kind }}/{{ row.row_id }}?compact=1"
              hx-target="#row-{{ row.kind }}-{{ row.row_id }}" hx-swap="outerHTML">Collapse</button>
      <a href="/me/history/{{ row.kind }}/{{ row.row_id }}/download/txt" download>Download TXT</a>
      <a href="/me/history/{{ row.kind }}/{{ row.row_id }}/download/json" download>Download JSON</a>
      <button class="danger" hx-delete="/me/history/{{ row.kind }}/{{ row.row_id }}"
              hx-vals='{"csrf_token": "{{ csrf_token }}"}'
              hx-confirm="Delete this {{ row.kind }}? It will be left out of future insights.">Delete</button>
    </div>
  </td>
</tr>
