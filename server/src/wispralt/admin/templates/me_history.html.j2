{% extends "base.html.j2" %}
{% set TAB_LABELS = {'today': 'Today', '7d': '7d', '30d': '30d', '90d': '90d', '1y': '1y', 'all': 'All'} %}
{% set KIND_LABELS = [('', 'All'), ('dictation', 'Dictations'), ('file', 'File transcriptions')] %}
{% block title %}My history · WisprAlt{% endblock %}
{% block content %}
  <div class="page-head">
    <div>
      <h1>My history</h1>
      <p class="muted">Your dictations and file transcriptions. Deleting a row also leaves it out of future insights.</p>
    </div>
  </div>
  <nav x-data="{ active: '{{ range }}' }" @range-changed.window="active = $event.detail" class="tabs" aria-label="Time range">
    {% for r in ['today', '7d', '30d', '90d', '1y', 'all'] %}
      <button :class="active === '{{ r }}' ? 'active' : ''" @click="active = '{{ r }}'"
              hx-get="/me/history"
              hx-vals='{"range": "{{ r }}", "kind": "{{ kind or '' }}", "search": "{{ search or '' }}"}'
              hx-target="#history-body" hx-swap="innerHTML" hx-push-url="true">{{ TAB_LABELS[r] }}</button>
    {% endfor %}
  </nav>
  <div class="filters">
    <input type="hidden" name="range" value="{{ range }}">
    <label class="sr-only" for="history-search">Search</label>
    <input id="history-search" type="search" name="search" placeholder="Search your transcripts…"
           value="{{ search or '' }}"
           hx-get="/me/history" hx-include="[name=range],[name=kind]"
           hx-trigger="keyup changed delay:300ms, search"
           hx-target="#history-body" hx-swap="innerHTML" hx-push-url="true">
    <label class="sr-only" for="history-kind">Kind</label>
    <select id="history-kind" name="kind" hx-get="/me/history" hx-include="[name=range],[name=search]"
            hx-trigger="change" hx-target="#history-body" hx-swap="innerHTML" hx-push-url="true">
      {% for opt_value, opt_label in KIND_LABELS %}
        <option value="{{ opt_value }}" {% if (kind or '') == opt_value %}selected{% endif %}>{{ opt_label }}</option>
      {% endfor %}
    </select>
  </div>
  <div id="history-body">{% include "_me_history_body.html.j2" %}</div>
{% endblock %}
