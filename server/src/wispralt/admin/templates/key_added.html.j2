{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui %}
{% block title %}API key {{ "created" if mode == "mint" else "rotated" }} · WisprAlt{% endblock %}
{% block content %}
  <div class="page-head">
    {% if mode == "mint" %}
      <h1>API key created for "{{ program_name }}"</h1>
    {% else %}
      <h1>API key rotated for "{{ program_name or label }}"</h1>
    {% endif %}
  </div>
  <p class="notice warn">
    {% if mode == "mint" %}<strong>Copy the key now.</strong> It is shown only once.
    {% else %}<strong>The old key no longer works.</strong> Paste the new one into the program now.{% endif %}
  </p>
  {% call ui.card("Key") %}{{ ui.secret_once(plaintext, "token") }}{% endcall %}
  {% call ui.card("Use it (OpenAI-compatible)") %}
    <p>Any program that speaks the OpenAI Whisper API routes to WisprAlt with these two variables:</p>
    {{ ui.secret_once("export OPENAI_BASE_URL=" ~ server_url ~ "/v1\nexport OPENAI_API_KEY=" ~ plaintext, "env") }}
  {% endcall %}
  <p><a href="/admin/integrations">Back to integrations</a></p>
{% endblock %}
