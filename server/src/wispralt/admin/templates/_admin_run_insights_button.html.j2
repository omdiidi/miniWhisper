{# Run-insights button. Inline in data.html.j2 and the OOB swap target of the
   run-now POST (id must match its hx-swap-oob="outerHTML"). #}
{% set oob = oob | default(false) %}
{% set running = running | default(false) %}
<div id="admin-run-insights-button" {% if oob %}hx-swap-oob="outerHTML"{% endif %} class="row">
  {% if running %}
    <button disabled>Running…</button>
  {% else %}
    <button hx-post="/admin/data/insights/run-now"
            hx-vals='{"csrf_token": "{{ csrf_token }}"}'
            hx-target="#admin-run-insights-toast"
            hx-swap="innerHTML">
      Run insights now
    </button>
  {% endif %}
  <span class="muted small">Costs about $0.65 per run</span>
</div>
