{% set hide_chrome = True %}
{% extends "base.html.j2" %}
{% block title %}Sign in · WisprAlt{% endblock %}
{% block bare_content %}
  <main class="login">
    <div class="card">
      <h1>WisprAlt portal</h1>
      <p class="muted">Paste your WisprAlt key to sign in.</p>
      {% if error %}<p class="error" role="alert">{{ error }}</p>{% endif %}
      <form method="post" action="/admin/login">
        <input type="hidden" name="csrf_token" value="{{ csrf_token }}">
        <label for="token">Key</label>
        <input id="token" name="token" type="password" autocomplete="off" autofocus required>
        <button type="submit" class="primary">Sign in</button>
      </form>
    </div>
  </main>
{% endblock %}
