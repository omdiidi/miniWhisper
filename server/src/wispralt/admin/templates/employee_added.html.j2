{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui %}
{% block title %}Employee added · WisprAlt{% endblock %}
{% block content %}
  <div class="page-head">
    <div>
      <h1>Employee added: {{ label }} <span class="muted">#{{ user_id }} · {{ role }}</span></h1>
      {% if display_name %}<p class="muted">Display name: <strong>{{ display_name }}</strong> (the app skips its name prompt).</p>{% endif %}
    </div>
  </div>
  <p class="notice warn"><strong>Copy this now.</strong> The key is shown only once; the server keeps only its hash.</p>

  {% call ui.card("1. Install command (send this to " ~ label ~ ")") %}
    {{ ui.secret_once(install_command, "install-cmd") }}
  {% endcall %}
  {% call ui.card("2. Just the key (to paste into Settings)") %}
    {{ ui.secret_once(plaintext, "token") }}
  {% endcall %}
  {% call ui.card("What the employee does") %}
    <ol>
      <li>Opens Terminal on the Mac they dictate from.</li>
      <li>Pastes the install command and presses Enter.</li>
      <li>The script downloads, signs in and launches WisprAlt.</li>
      <li>Grants the three macOS permissions (Accessibility, Input Monitoring, Microphone).</li>
    </ol>
  {% endcall %}
  <p><a href="/admin/users">Back to people</a> · <a href="/admin/users/new">Add another</a></p>
{% endblock %}
