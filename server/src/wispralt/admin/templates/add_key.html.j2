{% extends "base.html.j2" %}
{% import "_ui.html.j2" as ui %}
{% block title %}Add API key · WisprAlt{% endblock %}
{% block content %}
  <div class="page-head">
    <div>
      <h1>Add API key for a third-party program</h1>
      <p class="muted">Works against <code>/v1/audio/transcriptions</code> and <code>/v1/models</code> only.</p>
    </div>
  </div>
  {% if error %}<p class="notice bad" role="alert">{{ error }}</p>{% endif %}
  <form class="form card" method="post" action="/admin/keys/new">
    {{ ui.csrf(csrf_token) }}
    <label for="program_name">Program name</label>
    <input type="text" name="program_name" id="program_name" required maxlength="40" autofocus
           value="{{ form_program_name or '' }}" aria-describedby="pn-hint">
    <p class="hint" id="pn-hint">Shown in the portal, e.g. "Buzz on Bob's MacBook" or "Open WebUI prod".</p>
    <div class="actions">
      <button type="submit" class="primary">Create key</button>
      <a href="/admin/keys">Cancel</a>
    </div>
  </form>
{% endblock %}
