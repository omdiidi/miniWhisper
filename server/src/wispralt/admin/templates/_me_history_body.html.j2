{% if rows %}
<div class="table-wrap">
  <table>
    <thead><tr><th>Kind</th><th>When</th><th class="num">Words</th><th>{{ "Match" if searching else "Text" }}</th><th><span class="sr-only">Actions</span></th></tr></thead>
    <tbody id="history-rows">
      {% for row in rows %}{% include "_me_history_row.html.j2" %}{% endfor %}
    </tbody>
  </table>
</div>
{% include "_load_more.html.j2" %}
{% elif searching %}
<p class="empty">Nothing matches “{{ q }}” in this range.</p>
{% else %}
<p class="empty">No transcripts in this range. Adjust the range or kind.</p>
{% endif %}
