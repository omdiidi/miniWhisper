{% if rows %}
<div class="table-wrap">
  <table>
    <thead><tr><th>Kind</th><th>When</th><th class="num">Words</th><th>Text</th><th><span class="sr-only">Actions</span></th></tr></thead>
    <tbody id="history-rows">
      {% for row in rows %}{% include "_me_history_row.html.j2" %}{% endfor %}
    </tbody>
  </table>
</div>
{% if next_dict_cursor or next_jobs_cursor %}
  <button id="load-more" hx-get="/me/history"
          hx-vals='{"range": "{{ range }}", "kind": "{{ kind or '' }}", "search": "{{ search or '' }}", "dict_cursor": "{{ next_dict_cursor or '' }}", "jobs_cursor": "{{ next_jobs_cursor or '' }}"}'
          hx-target="this" hx-swap="outerHTML">Load more</button>
{% endif %}
{% else %}
<p class="empty">No transcripts in this range. Adjust the range, kind or search.</p>
{% endif %}
