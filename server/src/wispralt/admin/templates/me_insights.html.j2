{% extends "base.html.j2" %}
{% set TAB_LABELS = {'today': 'Today', '7d': '7d', '30d': '30d', '90d': '90d', '1y': '1y', 'all': 'All'} %}
{% block title %}My insights · WisprAlt{% endblock %}
{% block content %}
  <div class="page-head">
    <div>
      <h1>My insights · ISO {{ iso_year }}-W{{ "%02d" | format(iso_week) }}</h1>
      <p class="muted">Hi, {{ user.label }}. Here is what your week looked like.</p>
    </div>
  </div>
  <nav data-active="{{ range }}" x-data="{ active: $el.dataset.active }" @range-changed.window="active = $event.detail" class="tabs" aria-label="Time range">
    {% for r in ['today', '7d', '30d', '90d', '1y', 'all'] %}
      <button data-range="{{ r }}" :class="active === $el.dataset.range ? 'active' : ''" @click="active = $el.dataset.range"
              hx-get="/me/insights?range={{ r }}" hx-target="#insights-body" hx-swap="innerHTML"
              hx-push-url="true">{{ TAB_LABELS[r] }}</button>
    {% endfor %}
  </nav>
  <div id="insights-body">{% include "_me_insights_body.html.j2" %}</div>
{% endblock %}
