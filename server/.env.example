# WisprAlt server environment variables
# chmod 600 after population
# Copy this file to .env and fill in real values before starting the server.

# Absolute path of the data directory (wispralt.db, outputs/, staging/).
# scripts/setup-server.sh fills it with "$HOME/Library/Application Support/WisprAlt".
# Must be absolute: an empty or relative value is refused.
DATA_DIR=
SERVER_URL=
MAX_UPLOAD_BYTES=2147483648

# Rate limits (M6) — requests per rolling window, per real client IP.
# Rate limits use CF-Connecting-IP (Cloudflare Tunnel) for real-IP extraction.
DICTATE_RATE_PER_MIN=60

# Idle-eviction for the file transcription model. After this many seconds with
# no file-job activity (no in-flight job), the server unloads mlx-whisper to
# reclaim ~3 GB. The next file job pays a 5-30s cold-load cost. Set to 0 to
# disable (model stays warm forever).
FILE_MODEL_IDLE_EVICTION_SECONDS=60

# Hard cap on dictation audio length (post-resample, in seconds). Defends
# against decode-amplification (1KB body decoding to many minutes) and
# single-thread executor starvation. Default 300s = 5 min covers natural
# long-form hold-FN dictations. For longer audio, use Transcribe file.
DICTATION_MAX_DURATION_S=300

# Set to false if exposing FastAPI directly without Cloudflare Tunnel (e.g. LAN testing)
# to avoid IP spoofing in rate limiting. When true, CF-Connecting-IP is trusted.
TRUST_FORWARDED_HEADERS=true

# Optional: OpenRouter key for the weekly insights cron (Sunday-night LLM summary).
# Get a key at https://openrouter.ai/keys. Leave unset to disable weekly insights.
OPENROUTER_API_KEY=

# Retention is a DB setting (`retention_days`, default 0 = keep forever),
# not an env var; the Part 5 CLI sets it.

# Rotating application log (read by /admin/server-log). launchd's
# server.log / server.err.log now only receive crash output.
# SERVER_LOG_PATH=~/Library/Logs/WisprAlt/wispralt.log
# SERVER_LOG_MAX_BYTES=10485760
# SERVER_LOG_BACKUP_COUNT=5
